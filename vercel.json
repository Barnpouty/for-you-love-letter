{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["templates/**", "content/**", "config/**"] }
    },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400" },
      "dest": "/static/$1"
    },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}
