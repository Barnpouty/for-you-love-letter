# Copy to .env for local overrides (optional). On Vercel, set these in
# Project Settings → Environment Variables. All are optional.

# Your final public URL (used for canonical, Open Graph and sitemap links)
SITE_URL=https://your-domain.com

# Checkout links (defaults are already set in config/settings.py)
CHECKOUT_URL_EN=https://checkout.escalepay.com/2859029
CHECKOUT_URL_PT=https://checkout.escalepay.com/5931168

# Bump after replacing images/CSS/JS so browsers fetch the new files
ASSET_VERSION=1.0.0
